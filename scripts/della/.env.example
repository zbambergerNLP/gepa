# Copy this file to scripts/della/.env, run `chmod 600 scripts/della/.env`,
# and replace every placeholder. The Della scripts reject broader permissions.
REMOTE_USER="your_princeton_netid"
REMOTE_HOST="della.princeton.edu"
REMOTE_VIS_HOST="della-vis1.princeton.edu"
REMOTE_DIR="/scratch/gpfs/your_allocation/your_princeton_netid/gepa"
SCRATCH_BASE="/scratch/gpfs/your_allocation/your_princeton_netid/gepa"
# This project path must be visible from Della's visualization, login, and
# Slurm compute nodes. build_env.sh downloads both pinned checkpoints here.
MODEL_STORAGE="/projects/your_allocation/model_storage"
GPU_PARTITION="ailab"

# Della access uses your SSH agent or ~/.ssh/config. Add Princeton's verified
# host keys to ~/.ssh/known_hosts before running the build or submit scripts.

# Both scientific profiles are served inside their eight-H200 Slurm jobs.
# No hosted-model API credential is used by the production campaign.
